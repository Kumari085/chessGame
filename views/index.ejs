<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chess Game</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
      :root {
        --bg-1: #0f172a;
        --bg-2: #111827;
        --panel: rgba(15, 23, 42, 0.8);
        --board-border: rgba(255, 255, 255, 0.15);
        --light-square: #f5d7a1;
        --light-square-shadow: #d9b77a;
        --dark-square: #8b5e3c;
        --dark-square-shadow: #5f3e25;
        --piece-shadow: rgba(15, 23, 42, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: Arial, Helvetica, sans-serif;
        background: #18181b;
        color: white;
      }

      .game-shell {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .board-panel {
        position: relative;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 0;
        box-shadow: none;
      }

      .chessboard {
        position: relative;
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(8, 1fr);
        width: min(72vmin, 560px);
        height: min(72vmin, 560px);
        max-width: 560px;
        max-height: 560px;
        border-radius: 0;
        overflow: hidden;
        box-shadow: none;
        border: none;
      }

      .square {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
      }

      .square.white {
        background: #f0d9b5;
      }

      .square.black {
        background: #b58863;
      }

      .square:hover {
        filter: brightness(0.98);
      }

      .piece {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1;
        user-select: none;
        cursor: grab;
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
      }

      .piece.white {
        color: #fffaf0;
        -webkit-text-stroke: 1px #5b4632;
        text-shadow: 0 2px 3px rgba(0, 0, 0, 0.7);
      }

      .piece.black {
        color: #17120f;
        -webkit-text-stroke: 0.7px #f0d9b5;
        text-shadow: 0 2px 3px rgba(0, 0, 0, 0.75);
      }

      .piece:active {
        cursor: grabbing;
      }

      .captured-piece {
        display: inline-block;
        margin: 0 4px;
        font-size: 2rem;
        line-height: 1;
      }

      .captured-piece.white {
        color: #fffaf0;
        -webkit-text-stroke: 1px #5b4632;
        text-shadow: 0 2px 3px rgba(0, 0, 0, 0.7);
      }

      .captured-piece.black {
        color: #17120f;
        -webkit-text-stroke: 0.7px #f0d9b5;
        text-shadow: 0 2px 3px rgba(0, 0, 0, 0.75);
      }
    </style>
  </head>
  <body>
    <div class="game-shell">
      <div class="board-panel ">
        <h1>You: <span id="player-role">-</span></h1>
        <div class="flex gap-2 items-center">
          <div class="chessboard" aria-label="Chess board"></div>
          
        <div class=" captured-pieces h-134 w-100  bg-zinc-900 border flex flex-col justify-center ">
         
               <div class="h-1/2 p-3 w-full bg-zinc-800"> 
                <h1 class="top-2 font-semibold text-xl">Captured by White</h1>
                <div id="white-captured"></div>
        
               </div>
               <div class="h-1/2 p-3 w-full bg-white">
                <h1 class="top-2 font-semibold text-xl text-black">Captured by Black</h1>
                 <div id="black-captured"></div>
               </div>
        </div>
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script type="module" src="/script.js"></script>
  </body>
</html>
